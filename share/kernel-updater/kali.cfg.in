## kernel-updater kali.cfg template
##
## The menu stage of kernel-updater migrate renders multibootusb/grub/kali.cfg from this file:
## it drops the lines that start with ##, writes the lines between "## begin entry" and
## "## end entry" once per menu entry, and replaces each @NAME@ with its value in one pass.
## GRUB 2.02 syntax only, LF line endings, and no MultiBootUSB #start or #end markers, between
## which its uninstaller removes or rewrites what it finds.
# Kali GNU/Linux on this stick, loaded by multibootusb/grub/grub.cfg with source.
# Written by kernel-updater migrate; do not edit this file by hand. To change it, as for other
# menu_variants, run 'kernel-updater migrate --stage menu' again, which writes it anew from the
# legacy entries in grub.cfg; after the finalize stage removed them, roll that stage back first.
# The entries boot /vmlinuz and /initrd.img, which linux-base points at the newest kernel, and
# /vmlinuz.old and /initrd.img.old, which it points at the previous one, so this file stays the
# same when kernels are installed or removed.
submenu "@TITLE@" --id kali {
## begin entry
	menuentry "@ENTRY_TITLE@" --id @ENTRY_ID@ {
		insmod gzio
		insmod part_msdos
		insmod cryptodisk
		insmod luks
		insmod gcry_rijndael
		insmod gcry_sha256
		insmod ext2
		cryptomount -u @LUKS_UUID@
		search --no-floppy --fs-uuid --set=root --hint='cryptouuid/@LUKS_UUID@' @FS_UUID@
		if [ -s @KERNEL@ -a -s @INITRD@ ]; then
			echo 'Loading Linux (@WHICH@ kernel) ...'
			linux @KERNEL@ @CMDLINE@
			echo 'Loading initial ramdisk ...'
			initrd @INITRD@
		else
			echo '@KERNEL@ or @INITRD@ is missing on /boot: choose @OTHER@.'
			sleep 10
		fi
	}
## end entry
}
