# Editor defaults; .gitattributes decides what git stores.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash,bats}]
indent_style = space
indent_size = 4

[{.githooks/*,bin/*,hooks/kernel/**,lib/kernel-updater/apt-guard,*.awk}]
indent_style = space
indent_size = 4

# GRUB configs keep the tab indentation MultiBootUSB writes.
[*.cfg]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
