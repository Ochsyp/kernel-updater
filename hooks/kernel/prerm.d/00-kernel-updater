#!/bin/sh
# -------------------------------------------------------
# kernel-updater /boot guard for kernel removals
#
# install.sh puts this in /etc/kernel/prerm.d, where linux-run-hooks runs it with the kernel
# version and image path before a kernel package is removed. It refuses the removal while
# /boot is not the filesystem /etc/kernel-updater.conf names, so the kernel's files on the
# encrypted /boot never outlive its package. The 00- prefix runs it before the other prerm
# hooks.
# -------------------------------------------------------

set -eu

# Kernel hooks keep stdout clean, since debconf may be using it, and read nothing.
exec < /dev/null >&2

tool=/usr/local/bin/kernel-updater
if [ ! -x "$tool" ]; then
    echo "kernel-updater: warning: $tool is missing, so the /boot guard did not run"
    exit 0
fi
exec "$tool" hook boot-guard prerm "$@"
